# آدرس نهایی سایت (بدون / در انتها) — برای canonical، sitemap و سئو الزامی است
NEXT_PUBLIC_SITE_URL=https://your-domain.ir

# ارسال پیام‌های فرم تماس به تلگرام (ربات را از BotFather بسازید)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# اختیاری: کد تأیید Google Search Console (متای verification)
GOOGLE_SITE_VERIFICATION=
